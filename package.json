	"scripts": {
		"build": "react-router build",
		"test:run_old": "cross-env NODE_ENV=test yarn run tsx app/tests/all.ts",
		"test:run1": "vite build --ssr app/tests/all.ts && cross-env NODE_ENV=test node build/server/index.js",
		"test:run2": "vitest run",
		"test:run3": "vitest run --config vitest.integration-realdb.config.ts",
		"test:run1-3": "yarn test:run1 && yarn test:run2 && yarn test:run3",
		"dev": "yarn install && yarn dbsync && react-router dev --port 3000",
		"dev2": "yarn install && react-router dev --host",
		"start": "react-router-serve ./build/server/index.js",
		"tsc": "tsc",
		"dbsync": "yarn run drizzle-kit migrate",
		"build:binary:linux": "cat ./scripts/build_binary.sh | bash",
		"build:binary:win": ".\\scripts\\build_binary.bat",
		"coverage": "yarn vitest run --coverage --config vitest.config.ts",
		"mutation": "stryker run",
		"export_tables_for_translation": "tsx ./scripts/export_tables_for_translation.ts",
		"import_translation_tables": "tsx ./scripts/import_translation_tables.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"migration:validate:docker": "tsx ./scripts/db_migration_validation/load-dts-db-docker.ts",
		"migration:validate": "yarn migration:validate:docker",
		"prepare": "husky",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint-staged": "lint-staged",
		"i18n:extractor": "tsx ./scripts/extractor-i18n.ts",
		"i18n:extract:new": "i18next-cli extract",
		"i18n:check-missing-keys": "tsx scripts/check-i18n-missing-keys.ts",
		"build:css": "sass source/scss:public/assets/css"
	},
